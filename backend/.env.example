# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000
# Optional: public base URL of this API, used to build links to uploaded
# images (vendor logos/banners, catalog photos). Defaults to the request's
# own host if unset — set this once you deploy behind a real domain.
# PUBLIC_URL=https://api.esebelink.com

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/esebelink_marketplace
PGSSL=false

# Auth
JWT_SECRET=replace-this-with-a-long-random-string
JWT_EXPIRES_IN=7d
